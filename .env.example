# Copie este arquivo para ".env" e preencha com as credenciais do seu
# projeto Supabase (Project Settings > API no dashboard do Supabase).
#
# Variáveis EXPO_PUBLIC_* ficam embutidas no bundle do app — a anon key
# é segura para expor no client, o acesso real é controlado pelas
# policies de RLS definidas em supabase/schema_contas.sql.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
